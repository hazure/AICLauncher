# Ignore proprietary game binaries
*.dll
*.bak
*.orig
*.log

# Python cache
__pycache__/
*.pyc

# OS / Editor files
.DS_Store
*.swp
*~
*.exe

# Signing keys & secrets (must use GitHub Secrets)
*.keystore
*.jks
*.p12
*.pfx
*.pem

# RootFS archives & images (must not be committed)
*rootfs*.tar*
*.squashfs
*.img
*.ext4
*.iso
