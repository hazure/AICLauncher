[paths]
game_dir = .
stub = stub.exe
plugins = BepInEx/plugins
mods_pool = mods_pool

[graphics]
preset = low
hud_debug = 0
strongmem = 1

[mods]
unmosaic = on
unsafe_asm = off

[plugin]
log_output = BepInEx/LogOutput.log
require_trio = true

[watchdog]
log = Player.log
tail_ms = 800
auto_action = ask
