      "location": "game_root",
      "role": "network_hijack_dll",
      "check": "file_exists_and_matches_bepinex_major"
    },
    {
      "name": "doorstop_config.ini",
      "location": "game_root",
      "role": "bootstrap_config",
      "check": "target_assembly_points_to_BepInEx_core"
    },
    {
      "name": "BepInEx/",
      "location": "game_root",
      "role": "plugin_framework_dir",
      "check": "core_and_plugins_subdirs_writable"
    }
  ]
}
